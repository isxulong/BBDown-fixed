@echo off
rem ==================================================
rem  用途：合集/多P视频只下载其中几集
rem  用法：改两处：一是最后的BV号，二是 -p 后面的集数
rem  集数写法：
rem    -p 8      只下第8集
rem    -p 1,2    只下第1集和第2集
rem    -p 3-5    下第3集到第5集
rem    -p ALL    全部下载
rem    -p LAST   只下最新一集
rem ==================================================
cd /d %~dp0
BBDown -mt -p 1-5 BV12Rxq6nECN
pause
