<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>BBDownHelper</AssemblyName>
    <RootNamespace>BBDownHelper</RootNamespace>
    <!-- v3.2：exe 文件图标 + 任务栏/快捷方式图标 -->
    <ApplicationIcon>Assets\BBDownHelper.ico</ApplicationIcon>
    <!-- v3.4：版本标识（exe 文件属性可见） -->
    <!-- v3.5：内部版本升至 3.5.0；对外发布版本号（窗口标题/检查更新）单一来源在 Core 的 AppVersion -->
    <!-- v3.6：内部版本升至 3.6.0（封面竞态修复 + 412 风控降级重试）；对外发布号仍为 1.0.3 不变 -->
    <!-- v3.7：内部版本升至 3.7.0（v1.0.4 批次 1：NetFacade 薄层 + UP 导出验证 + 识别窗口期修复 + R1.3~R1.9）；对外发布号 1.0.4 由发版批统一改 -->
    <!-- v3.8：内部版本升至 3.8.0（v1.0.4 批次 2：地基三件套 LogStore/AppConfig/ErrorMapper + P2-1 启动失败假死修复 + R2.1~R2.11）；对外发布号仍 1.0.3，发版批统一改 -->
    <!-- v3.9：内部版本升至 3.9.0（红队复检：P2-1 脱敏加宽 JSON/tab/多空白形态 + 文案去绝对化；P2-2 LogStore 落盘写锁 + 退避重试）；AppVersion.Release 仍 1.0.3 不动 -->
    <!-- v4.0：内部版本升至 4.0.0（v1.0.4 批次 3：界面结构与交互体验 R3.1~R3.13 + 可达性基线）；AppVersion.Release 仍 1.0.3 不动（发版批统一改 1.0.4） -->
    <Version>4.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BBDownHelper.Core\BBDownHelper.Core.csproj" />
  </ItemGroup>
</Project>
