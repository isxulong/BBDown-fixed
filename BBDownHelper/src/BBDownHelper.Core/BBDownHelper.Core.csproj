<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BBDownHelper.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- GBK/GB18030 等非 Unicode 代码页：子进程控制台输出解码用（ConsoleEncoding） -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- CoreDataMigrator.Execute(baseDir, listFiles) 内部可测重载：测试工程直接调用 -->
    <InternalsVisibleTo Include="BBDownHelper.Core.Tests" />
  </ItemGroup>

</Project>
